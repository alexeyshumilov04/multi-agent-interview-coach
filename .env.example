# Multi-Agent Interview Coach — LLM через AITUNNEL
# Скопируйте в .env и укажите ключ.

# AITUNNEL (обязательно для доступа к LLM)
AITUNNEL_API_KEY=sk-aitunnel-xxx
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/
AITUNNEL_MODEL=deepseek-r1

# Fallback: если AITUNNEL_API_KEY не задан, используется OPENAI_API_KEY
# OPENAI_API_KEY=sk-...
